# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ─────────────────────────────────────────────────────────────────
# Full MongoDB connection string (local or Atlas).
# Example (local):  mongodb://127.0.0.1:27017/career-pivot-coach
# Example (Atlas):  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=
MONGO_URI=
LOCAL_MONGODB_URI=mongodb://127.0.0.1:27017/career_pivot_coach

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Example: http://localhost:5173,https://yourdomain.com
CLIENT_ORIGIN=http://localhost:5173

# ─── Firebase Admin SDK (Authentication & ID Token Verification) ──────────────
FIREBASE_PROJECT_ID=career-pivot-coach
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=

# ─── Auth (for future JWT implementation) ────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ─── Google Gemini AI Developer API (Free Tier) ──────────────────────────────
# Optional: Get your free API key from https://aistudio.google.com/
# If omitted or invalid, the system automatically falls back to deterministic NLP.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

